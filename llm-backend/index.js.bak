const express = require('express');
const cors = require('cors');
const axios = require('axios');
const app = express();

app.use(cors());
app.use(express.json());

// Ganti IP ini sesuai dengan gateway kamu saat ini
const WSL_GATEWAY_IP = '172.21.128.1';

app.get('/api/models', async (req, res) => {
    try {
        const response = await axios.get(`http://${WSL_GATEWAY_IP}:1234/v1/models`);
        
        // Filter: Hanya tampilkan model yang bukan embedding (opsional, tapi disarankan)
        const chatModels = response.data.data
            .filter(model => !model.id.includes('embed'))
            .map(model => ({
                id: model.id,
                name: model.id,
                type: 'LOCAL - ONLINE'
            }));
        
        res.json({ success: true, models: chatModels });
    } catch (error) {
        console.error("Local model detection failed:", error.message);
        res.json({ success: false, models: [] });
    }
});

// ROUTE BARU: Menangani Multiple Models
app.post('/api/chat', async (req, res) => {
    // Sekarang menerima 'modelIds' sebagai array (contoh: ['llama-3.2-1b-instruct'])
    const { prompt, modelIds } = req.body; 

    if (!modelIds || modelIds.length === 0) {
        return res.json({ success: false, error: "No models selected." });
    }

    try {
        // Membuat kumpulan "tugas" (promises) untuk ditembakkan bersamaan
        const apiRequests = modelIds.map(async (modelId) => {
            console.log(`Routing request to: ${modelId}`);
            
            // Saat ini semua diarahkan ke LM Studio lokal
            // Nanti di sini kita tambahkan logika IF-ELSE untuk Gemini/OpenAI
            try {
                const response = await axios.post(`http://${WSL_GATEWAY_IP}:1234/v1/chat/completions`, {
                    model: modelId,
                    messages: [
                        { role: "system", content: "You are a helpful AI assistant." },
                        { role: "user", content: prompt }
                    ],
                    temperature: 0.7,
                    stream: false
                });

                return {
                    modelId: modelId,
                    success: true,
                    answer: response.data.choices[0].message.content
                };
            } catch (err) {
                return {
                    modelId: modelId,
                    success: false,
                    error: err.message
                };
            }
        });

        // Eksekusi paralel: Tunggu semua model menjawab
        const results = await Promise.all(apiRequests);
        res.json({ success: true, responses: results });

    } catch (error) {
        console.error("Parallel execution error:", error.message);
        res.json({ success: false, error: "System failure during model execution." });
    }
});

app.listen(3000, () => {
    console.log("=========================================");
    console.log("🚀 MULTI-ENGINE BACKEND READY (Port 3000)");
    console.log("=========================================");
});